{
  "name": "frontend",
  "private": true,
  "version": "3.10.6",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:backend": "cd ../backend && venv\\Scripts\\python.exe -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload --reload-dir app --reload-include main.py",
    "dev:tray": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/tray_manager.ps1",
    "dev:all": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,magenta\" \"pnpm run dev:backend\" \"pnpm run dev\"",
    "start:all": "concurrently --names \"BACKEND,FRONTEND,TRAY\" --prefix-colors \"blue,magenta,cyan\" \"pnpm run dev:backend\" \"pnpm run dev\" \"pnpm run dev:tray\"",
    "build": "tsc -b && vite build",
    "electron:dev": "concurrently --names \"BACKEND,FRONTEND,ELECTRON\" --prefix-colors \"blue,magenta,green\" \"pnpm run dev:backend\" \"pnpm run dev\" \"electron electron/main.cjs\"",
    "electron:pack": "electron-builder --dir",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.tranvankha.videotranslateai",
    "productName": "VideoTranslate AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "../assets/app.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "mammoth": "^1.12.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
