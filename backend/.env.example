# ==============================================================================
# CẤU HÌNH HỆ THỐNG VIDEOTRANSLATE AI & OMNIVOICE TTS
# 
# Hướng dẫn: Đổi tên file này thành `.env` để cấu hình có hiệu lực.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THIẾT BỊ & MÔ HÌNH (LOCAL HARDWARE)
# ------------------------------------------------------------------------------
# Thiết bị chạy mô hình:
# - 'cuda' : Khuyên dùng cho card đồ họa NVIDIA (GTX 1650, RTX 3060, RTX 40xx...)
# - 'cpu'  : Dành cho máy không có GPU rời
OMNIVOICE_DEVICE=cuda

# Kiểu dữ liệu mô hình:
# - 'float16' : Giảm 50% VRAM, tốc độ suy luận nhanh nhất trên GPU
# - 'float32' : Dành cho CPU hoặc khi gặp lỗi số học
OMNIVOICE_DTYPE=float16

# Tên mô hình HuggingFace hoặc đường dẫn local
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice

# ------------------------------------------------------------------------------
# 2. TỐI ƯU HOÁ TỐC ĐỘ THEO CẤU HÌNH PHẦN CỨNG (GPU / CPU)
# ------------------------------------------------------------------------------
# Số bước khử nhiễu Diffusion (num_step):
# - 8 - 10 : Tối ưu tốc độ cao nếu chạy CPU (nhanh gấp 3-4 lần).
# - 16     : Tốc độ cao, tối ưu cho GTX 1650 / RTX 2050/3050 4GB.
# - 24 - 32: Chuẩn Studio mượt mà nhất cho RTX 3060 / 4060 hoặc khi chạy qua Google Colab GPU T4.
DEFAULT_NUM_STEP=32

# ------------------------------------------------------------------------------
# 3. KẾT NỐI CLOUD GPU TỪ XA (HUGGING FACE SPACES A100 / GOOGLE COLAB T4)
# ------------------------------------------------------------------------------
# Bật tính năng uỷ quyền tính toán mô hình OmniVoice sang Cloud GPU từ xa (true / false).
# Hỗ trợ: Hugging Face Spaces (ZeroGPU A100 miễn phí) hoặc Google Colab (GPU T4 16GB).
# Khi bật, máy local KHÔNG cần GPU, không tốn RAM, toàn bộ âm thanh sinh siêu tốc trên Cloud.
USE_REMOTE_GPU=true

# Địa chỉ Public API của Hugging Face Spaces hoặc Google Colab:
# - Hugging Face Space ví dụ: https://khanhtieu-self-tts-worker.hf.space
# - Google Colab ví dụ: https://barman-leverage-umbrella.ngrok-free.dev
REMOTE_GPU_URL=https://tranvankha2807-translate.hf.space

# Số luồng xử lý song song gửi lên Cloud GPU (mặc định: 2 luồng đồng thời)
REMOTE_CONCURRENCY=2

# Hugging Face Access Token & Space Repo để tự động đánh thức khi khởi động
HF_TOKEN=
HF_SPACE_REPO=

# Đường dẫn mở Google Colab Notebook cá nhân (hệ thống tự động mở trình duyệt khi bật app):
COLAB_NOTEBOOK_URL=https://colab.research.google.com/github/tranvankha1989/VoxCPM-TTS/blob/main/notebooks/OmniVoice_Colab_T4.ipynb

# Độ dài ký tự tối đa của mỗi đoạn cắt (max_chars):
# - 450 - 500 : (Khuyên dùng) Giữ nguyên mạch cảm xúc và ngữ điệu tự nhiên của đoạn văn,
#               giảm số lần phân mảnh âm thanh, không bị ngắt câu vụn về.
# - 200 - 250 : Chỉ dùng nếu muốn ngắt nhiều câu ngắn.
MAX_CHUNK_CHARS=450

# Hệ số căn chỉnh độ dài token âm thanh (mặc định 1.0):
# - 1.0 : (Khuyên dùng tuyệt đối) Khớp chính xác với mô hình OmniVoice gốc, không bị vấp/lặp từ.
# - > 1.0 (như 1.2): Dư thừa thời gian sinh khiến mô hình cố kéo dài âm hoặc ậm ừ/lặp lại từ.
TOKEN_PADDING_FACTOR=1.0

# Chạy Warmup GPU 1 lần duy nhất khi khởi động (true / false):
# - false : (Khuyên dùng) Tắt để vào việc ngay lập tức, không tốn tài nguyên chạy thử.
# - true  : Chạy 1 câu mẫu ngắn khi bật server để làm nóng nhân CUDA trước.
ENABLE_WARMUP_ONCE=true

# Ép giải phóng bộ nhớ GPU (empty_cache) sau mỗi đoạn (true / false):
# - false : (Khuyên dùng) Không ép xả cache giúp GPU xử lý liền mạch, không bị khựng delay.
# - true  : Chỉ bật nếu VRAM rất ít (< 3GB) và gặp lỗi CUDA Out of Memory.
ENABLE_EMPTY_CACHE=false

# Tăng tốc tính toán ma trận cuDNN (true / false):
# - true  : Bật chế độ tìm thuật toán ma trận tối ưu nhất cho GPU NVIDIA.
CUDNN_BENCHMARK=true

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH XUẤT FILE ÂM THANH (AUDIO EXPORT)
# ------------------------------------------------------------------------------
# Thư viện mã hóa xuất file MP3 (audio export backend):
# - 'auto'       : (Khuyên dùng) Tự động ưu tiên soundfile, tự fallback sang torchaudio nếu lỗi.
# - 'soundfile'  : Dùng thư viện soundfile (yêu cầu libsndfile >= 1.1.0, không cần TorchCodec/FFmpeg).
#                  Tối ưu tuyệt đối cho máy không có TorchCodec hoặc chạy CPU trên Windows.
# - 'torchaudio' : Dùng torchaudio.save (chuẩn gốc trên máy bàn có GPU/CUDA/TorchCodec).
#                  Nếu máy thiếu TorchCodec, hệ thống vẫn tự động chuyển đổi fallback sang soundfile.
AUDIO_MP3_BACKEND=auto

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH NHẬN DIỆN GIỌNG NÓI (WHISPER ASR) & DỊCH THUẬT (LLM GEMINI)
# ------------------------------------------------------------------------------
# Kích thước mô hình Whisper: 'tiny', 'base', 'small', 'medium', 'large-v3' (Khuyên dùng: large-v3)
WHISPER_MODEL_SIZE=large-v3

# Khóa API Gemini dịch video & văn bản (lấy miễn phí tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 6. TÙY CHỌN: ĐỒNG BỘ ĐA THIẾT BỊ (CLOUD SYNC - MONGODB ATLAS & CLOUDFLARE R2)
# ------------------------------------------------------------------------------
# LƯU Ý QUAN TRỌNG:
# - Phần cấu hình này là TÙY CHỌN (OPTIONAL).
# - Nếu bạn để trống hoặc không điền, hệ thống sẽ tự động chạy ở chế độ CỤC BỘ (Local Mode).
#   Toàn bộ kịch bản, dự án và từ điển phát âm sẽ được lưu an toàn trong LocalStorage của trình duyệt.
# - Nếu bạn muốn đồng bộ giữa nhiều máy tính (ví dụ: máy bàn & laptop):
#   1. Tạo cluster MongoDB Atlas miễn phí (512MB) tại https://www.mongodb.com/cloud/atlas
#   2. Tạo tài khoản Cloudflare R2 miễn phí (10GB dung lượng, 0đ băng thông egress) tại https://dash.cloudflare.com/

# Chuỗi kết nối MongoDB Atlas (để trống = Local Mode / LocalStorage)
MONGODB_URI=
MONGODB_DB_NAME=omnivoice

# Cấu hình Cloudflare R2 Object Storage để lưu file audio đám mây (để trống = lưu file cục bộ trong /outputs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Domain public của R2 (ví dụ: https://pub-xxxxxx.r2.dev hoặc https://media.yourdomain.com)
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 7. CẤU HÌNH TELEGRAM BOT NHẬN PHẢN HỒI & LOGS TỪ KHÁCH HÀNG
# ------------------------------------------------------------------------------
# Token Bot lấy từ @BotFather:
TELEGRAM_BOT_TOKEN=

# Chat ID của bạn lấy từ @userinfobot:
TELEGRAM_CHAT_ID=

VERBOSE_LOGGING=false
