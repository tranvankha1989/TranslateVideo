# ─────────────────────────────────────────────────────────────
# OmniVoice / VideoTranslate AI — Environment Configuration (.env)
# ─────────────────────────────────────────────────────────────

# 1. Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# 2. Remote GPU Worker Configuration (Hugging Face / Google Colab / Kaggle)
USE_REMOTE_GPU=False
REMOTE_GPU_URL=
REMOTE_CONCURRENCY=2
DEFAULT_NUM_STEP=32
AUDIO_MP3_BACKEND=auto

# Hugging Face ZeroGPU Auto-Wakeup & Token (Tùy chọn)
HF_TOKEN=
HF_SPACE_REPO=
COLAB_NOTEBOOK_URL=https://colab.research.google.com/github/tranvankha1989/VoxCPM-TTS/blob/main/notebooks/OmniVoice_Colab_T4.ipynb

# 3. Speech-to-Text (Whisper) Settings
WHISPER_MODEL_SIZE=large-v3

# 4. Translation & AI LLM API Keys
GEMINI_API_KEY=

# 5. Cloud Database Sync (MongoDB Atlas - Tùy chọn)
# Để trống nếu muốn chạy Local Database hoàn toàn
MONGODB_URI=
MONGODB_DB_NAME=omnivoice

# 6. Cloudflare R2 Storage (Lưu trữ Audio/Video đám mây - Tùy chọn)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# 7. Telegram Bot Feedback & Error Logs (Nhận phản hồi & logs khách hàng)
TELEGRAM_BOT_TOKEN=8637750224:AAHev518siDN1yzTTi5h-Hxd8-eCVbiBp20
TELEGRAM_CHAT_ID=7691076251
