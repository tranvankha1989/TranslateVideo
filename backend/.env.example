# ─────────────────────────────────────────────────────────────
# OmniVoice TTS — Environment Configuration Example (.env.example)
# ─────────────────────────────────────────────────────────────

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Remote GPU Worker Configuration (Google Colab / Kaggle T4)
USE_REMOTE_GPU=False
REMOTE_GPU_URL=

# Speech-to-Text (Whisper) Settings
WHISPER_MODEL_SIZE=large-v3

# Translation API Keys
GEMINI_API_KEY=
